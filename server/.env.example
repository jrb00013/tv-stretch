# Copy to .env in this directory (optional). All vars use prefix TV_STRETCH_

TV_STRETCH_DATABASE_URL=sqlite:///./tv_stretch.db
TV_STRETCH_PUBLIC_BASE_URL=http://127.0.0.1:8000
TV_STRETCH_CORS_ORIGINS=*
TV_STRETCH_DEBUG=false

# Minimum occupancy confidence (0–1) before POST /presence/occupancy triggers TV handoff
TV_STRETCH_PRESENCE_HANDOFF_MIN_CONFIDENCE=0.65

# Presence hysteresis. All default to 0 = off, which keeps the original behaviour of
# handing off on the first reading. Raise dwell to stop sensor noise / passers-by from
# switching TVs; set release to stand the TVs down when the active room empties.
TV_STRETCH_PRESENCE_DWELL_SECONDS=0
TV_STRETCH_PRESENCE_DWELL_MAX_GAP_SECONDS=30
TV_STRETCH_PRESENCE_RELEASE_SECONDS=0

# Optional caps on how many rooms/nodes a home may create
TV_STRETCH_MAX_ROOMS_PER_HOME=50
TV_STRETCH_MAX_NODES_PER_HOME=20

# MQTT broker for external event publishing
TV_STRETCH_MQTT_BROKER_URL=localhost
TV_STRETCH_MQTT_BROKER_PORT=1883
TV_STRETCH_MQTT_ENABLED=true
TV_STRETCH_MQTT_PREFIX=tvstretch

# Optional OTA bundle on disk (see docs)
# TV_STRETCH_OTA_FIRMWARE_PATH=
# TV_STRETCH_OTA_FIRMWARE_VERSION=0.6.0
